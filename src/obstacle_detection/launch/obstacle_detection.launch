<!--
  障碍物检测节点启动文件

  该节点用于电梯和库位场景下的障碍物检测，通过融合中距雷达和补盲雷达的点云数据，
  对目标区域进行异物检测，并通过位标志向下游系统报告检测结果。

  所有运行时参数均从yaml配置文件加载，修改yaml后自动重载(最多1秒生效)。

  订阅的Topics:
    - points_mid_topic (sensor_msgs/PointCloud2): 中距雷达点云(默认/points_mid_calibration)
    - /fused_points_tip (sensor_msgs/PointCloud2): 补盲雷达点云
    - /keypoint_path (autoware_msgs/KeyPointArray): 导航关键点路径
    - /feedback_status (autoware_remove_msgs/State): 反馈状态
    - /elevator_info (autoware_msgs/ElevatorInfo): 电梯信息
    - /lqr_dire (std_msgs/Int8): 电梯控制方向标志
    - /floor_set (std_msgs/Int8): 目标楼层设置
    - /current_pose (geometry_msgs/PoseStamped): 当前车辆位姿

  发布的Topics:
    - /obstacle_detection (std_msgs/UInt32): 障碍物检测状态(位标志)
    - /points_fused_detection (sensor_msgs/PointCloud2): 融合后的点云
    - /target_region_points (sensor_msgs/PointCloud2): 目标区域内点云
    - /ground_points_mid (sensor_msgs/PointCloud2): 地面点云
    - /obstacle_points_mid (sensor_msgs/PointCloud2): 障碍物点云
    - /clustered_points_mid (sensor_msgs/PointCloud2): 彩色聚类点云
    - /obstacle_detection_markers (visualization_msgs/MarkerArray): 可视化标记
-->
<launch>
    <node pkg="obstacle_detection" type="obstacle_detection" 
          name="obstacle_detection" output="screen">
        <!-- 加载yaml配置文件(包含所有运行时参数，支持修改后自动重载) -->
        <!-- <rosparam file="$(find obstacle_detection)/params/obstacle_detection.yaml" command="load"/> -->

        <rosparam file="$(env HOME)/perception/workspace/param/obstacle_detection.yaml" command="load"/>
    </node>
</launch>